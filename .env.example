# =============================================================================
# Konkred AI Ecosystem — environment template
# Copy to `.env` (setup.sh does this for you) and fill in real values.
#   cp .env.example .env
# NEVER commit the resulting `.env` — it is git-ignored.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. TELEGRAM BOT  (required)
# -----------------------------------------------------------------------------
# From @BotFather → /newbot. Format: <bot-id>:<secret>
TELEGRAM_BOT_TOKEN=

# Comma separated Telegram user IDs allowed to talk to the bot.
# Leave EMPTY to allow anyone who finds the bot.
ALLOWED_USER_IDS=

# Markdown | HTML | (empty = plain text). Falls back to plain text automatically
# when Telegram rejects an entity.
PARSE_MODE=Markdown
DROP_PENDING_UPDATES=true
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 2. GATEWAY SECURITY  (required)
# -----------------------------------------------------------------------------
# Admin key for GET /api/status and cache flush. Generate one with:
#   openssl rand -hex 32
ADMIN_KEY=change-me-to-a-secure-random-secret

# Caller directory. `key` is what clients send in the `x-api-key` header.
# The bot uses GATEWAY_API_KEY below; add more entries to expose the gateway
# to other internal services. Tiers: internal | trusted | standard | free
USERS_JSON=[{"key":"bot-internal-key","userId":"telegram-bot","tier":"internal"}]

# Must match one of the "key" values in USERS_JSON.
GATEWAY_API_KEY=bot-internal-key

# Set to true only for local experiments (allows keyless calls as tier "free").
ALLOW_ANONYMOUS=false

# -----------------------------------------------------------------------------
# 3. SERVICE WIRING  (defaults are correct for docker compose)
# -----------------------------------------------------------------------------
# Inside the compose network the bot reaches the gateway by service name.
GATEWAY_URL=http://gateway:3000/api/ai
GATEWAY_HEALTH_URL=http://gateway:3000/api/health
REDIS_URL=redis://redis:6379/0

# Host port published for the gateway (container always listens on 3000).
GATEWAY_PORT=3000

# Redis memory ceiling for the state store container.
REDIS_MAXMEMORY=256mb

# -----------------------------------------------------------------------------
# 4. GATEWAY ROUTING BEHAVIOUR  (optional — sane defaults built in)
# -----------------------------------------------------------------------------
# Offline simulator: true = never call real providers (CI / local demos).
DEMO_MOCK=false
# true = use the simulator as last-resort capacity when every live provider is
# cooling down. Set to false in production if you prefer hard 503s over mock text.
MOCK_FALLBACK=true

MAX_ATTEMPTS=6
ATTEMPT_TIMEOUT_MS=90000
CONNECT_TIMEOUT_MS=10000
DEFAULT_MAX_TOKENS=2048
HARD_MAX_TOKENS=8192
CACHE_ENABLED=true
CACHE_TTL_MS=900000
DEDUP_ENABLED=true
WATCHDOG_ENABLED=true
WATCHDOG_INTERVAL_MS=60000
DASHBOARD_ENABLED=true

# -----------------------------------------------------------------------------
# 5. FREE-TIER PROVIDER CREDENTIALS  (add as many as you have)
#    At least ONE provider key is required unless DEMO_MOCK=true.
# -----------------------------------------------------------------------------
# Google AI Studio — https://aistudio.google.com/app/apikey
# Separate Google Cloud projects give independent daily quotas.
# Resets at Pacific midnight.
GEMINI_KEY_P1=
GEMINI_KEY_P2=
GEMINI_KEY_P3=

# Groq Cloud — https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras Inference — https://cloud.cerebras.ai/  (1M tokens/day free)
CEREBRAS_API_KEY=

# Mistral La Plateforme — https://console.mistral.ai/
MISTRAL_API_KEY=

# OpenRouter — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_REFERER=https://github.com/reARbitRA/konkred-AI-ecosystem
OPENROUTER_TITLE=Konkred Gateway

# Cloudflare Workers AI — https://dash.cloudflare.com/
CF_ACCOUNT_ID=
CF_API_TOKEN=

# GitHub Models — https://github.com/settings/tokens (fine-grained, models:read)
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# 6. BOT RESILIENCE TUNING  (optional)
# -----------------------------------------------------------------------------
GATEWAY_TIMEOUT=120
GATEWAY_CONNECT_TIMEOUT=10
GATEWAY_MAX_RETRIES=3
GATEWAY_RETRY_BACKOFF=0.8
GATEWAY_RETRY_BACKOFF_MAX=12
GATEWAY_MAX_RETRY_WAIT=20
STARTUP_WAIT_TIMEOUT=180

HISTORY_MAX_TURNS=10
HISTORY_TTL_SECONDS=86400
HISTORY_MAX_CHARS=24000
CHUNK_SIZE=3900
TELEGRAM_MESSAGE_LIMIT=4096
CHUNK_DELAY=0.05
SHOW_PROVIDER_FOOTER=true

# -----------------------------------------------------------------------------
# 7. CLOUD / MANAGED REDIS  (only needed when NOT using the compose redis service)
# -----------------------------------------------------------------------------
# Render / Koyeb / Fly have no free persistent Redis container; point REDIS_URL
# at Upstash (free tier) instead, e.g.
#   REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# 8. ADVANCED GATEWAY KNOBS  (optional — every value below is already defaulted)
# -----------------------------------------------------------------------------
# Override the bundled model/quota registry.
REGISTRY_PATH=data/policies.registry.json
# Alternative to inline USERS_JSON: path to a JSON array file.
USERS_JSON_PATH=
# Per-caller tier budgets (requests per minute / per day, tokens per day).
INTERNAL_RPM=240
INTERNAL_RPD=100000
INTERNAL_TPD=0
TRUSTED_RPM=30
TRUSTED_RPD=2000
TRUSTED_TPD=2000000
STANDARD_RPM=10
STANDARD_RPD=500
STANDARD_TPD=500000
FREE_RPM=4
FREE_RPD=120
FREE_TPD=150000
ANONYMOUS_TIER=free
# Upstream attempt shaping.
MAX_MESSAGES=60
REQUEST_BODY_LIMIT_BYTES=2097152
COOLDOWN_AFTER_RATE_LIMIT_MS=60000
COOLDOWN_AFTER_AUTH_FAILURE_MS=3600000
CONTEXT_TRIM_RATIO=0.45
DEDUP_TTL_MS=120000
CACHE_MAX_ENTRIES=500

# -----------------------------------------------------------------------------
# 9. BOT OPS  (optional)
# -----------------------------------------------------------------------------
DEFAULT_TASK=general
REDIS_MAX_CONNECTIONS=20
HEARTBEAT_PATH=/tmp/konkred-bot-heartbeat
HEARTBEAT_MAX_AGE=180

# -----------------------------------------------------------------------------
# 10. FULLKONK BRAIN  (konkred.xyz/fullkonk integration)
#     FULLKONK_KEY: shared secret the website edge proxy sends as x-brain-key.
#     Leave blank only for local development; set it in production.
#     CORS_ALLOW_ORIGINS: comma-separated browser origins allowed to call the
#     gateway directly (the Vercel proxy path does not need CORS at all).
# -----------------------------------------------------------------------------
FULLKONK_KEY=
CORS_ALLOW_ORIGINS=https://konkred.xyz,https://www.konkred.xyz
CORS_ALLOW_ALL=false
